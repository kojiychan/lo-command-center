# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server-only: used for public registration + reminder row creation (bypasses RLS safely inside validated server actions)
# In production, prefer a Supabase Edge Function or database RPC instead of the service role in the app server.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional: used for email confirmation redirects (Supabase Auth)
# Example: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Email sending (Resend)
RESEND_API_KEY=
EMAIL_FROM_DOMAIN=arc-mortgage.com
FALLBACK_FROM_EMAIL=team@arc-mortgage.com

# Reminder worker authorization.
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` when CRON_SECRET is configured.
# REMINDER_CRON_SECRET is also supported for non-Vercel schedulers.
CRON_SECRET=
REMINDER_CRON_SECRET=
